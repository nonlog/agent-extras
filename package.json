{
  "name": "agent-extras",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "nonlog",
  "type": "module",
  "description": "Extensions and scripts for coding agents: Pi UI/title/notification extensions, model-specific prompt routing, Windows CLI notifications, and Claude Code / Droid CLI status bar scripts",
  "homepage": "https://github.com/nonlog/agent-extras#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonlog/agent-extras.git"
  },
  "bugs": {
    "url": "https://github.com/nonlog/agent-extras/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "tui"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-polish/extensions/tools.ts",
      "./packages/pi-polish/extensions/chrome.ts",
      "./packages/pi-polish/extensions/footer.ts",
      "./packages/pi-bar-cursor/extensions/bar-cursor.ts",
      "./packages/pi-spinner-verbs/extensions/spinner-verbs",
      "./packages/pi-model-prompts/extensions/model-prompts.js",
      "./packages/pi-auto-session-title/extensions/auto-session-title.ts",
      "./packages/windows-cli-notify/adapters/pi-windows-notify.ts"
    ]
  },
  "dependencies": {
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "diff": "9.0.0",
    "shiki": "4.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
