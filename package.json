{
  "name": "pi-extensions",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "author": "nonlog",
  "type": "module",
  "description": "Pi extensions: patched forks of pi-polish and pi-spinner-verbs plus pi-bar-cursor, kept together so they can be installed from one source",
  "homepage": "https://github.com/nonlog/pi-extensions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonlog/pi-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/nonlog/pi-extensions/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "tui"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-polish/extensions/tools.ts",
      "./packages/pi-polish/extensions/chrome.ts",
      "./packages/pi-polish/extensions/footer.ts",
      "./packages/pi-bar-cursor/extensions",
      "./packages/pi-spinner-verbs/extensions/spinner-verbs"
    ]
  },
  "dependencies": {
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "diff": "9.0.0",
    "shiki": "4.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
